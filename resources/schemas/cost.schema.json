{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdt-rop.org/schema/cost.schema.json",

  "title": "Cost Schema",
  "description": "Canonical cost model used throughout CDT-ROP.",

  "type": "object",

  "required": [
    "metadata",
    "cost"
  ],

  "properties": {

    "metadata": {
      "type": "object",
      "required": [
        "currency",
        "unit_system"
      ],
      "properties": {

        "currency": {
          "type": "string"
        },

        "unit_system": {
          "type": "string"
        },

        "price_date": {
          "type": "string",
          "format": "date"
        }

      }
    },

    "cost": {

      "type": "object",

      "required": [
        "categories"
      ],

      "properties": {

        "categories": {

          "type": "array",

          "items": {
            "$ref": "#/$defs/costCategory"
          }

        },

        "total_cost": {
          "type": [
            "number",
            "null"
          ]
        }

      }

    }

  },

  "$defs": {

    "costCategory": {

      "type": "object",

      "required": [
        "name",
        "items"
      ],

      "properties": {

        "name": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "items": {

          "type": "array",

          "items": {
            "$ref": "#/$defs/costItem"
          }

        }

      }

    },

    "costItem": {

      "type": "object",

      "required": [
        "code",
        "description",
        "quantity",
        "unit"
      ],

      "properties": {

        "code": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "quantity": {
          "type": "number"
        },

        "unit": {
          "type": "string"
        },

        "unit_rate": {
          "type": [
            "number",
            "null"
          ]
        },

        "subtotal": {
          "type": [
            "number",
            "null"
          ]
        },

        "source": {
          "type": "string"
        }

      }

    }

  }

}