/* ============================================================================
   CDT-ROP Light Theme
   Constructive Digital Twin Road Optimization Platform
   ============================================================================ */

/* ---------------------------------------------------------------------------
   Global
--------------------------------------------------------------------------- */

QWidget {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ---------------------------------------------------------------------------
   Main Window
--------------------------------------------------------------------------- */

QMainWindow {
    background-color: #F8FAFC;
}

/* ---------------------------------------------------------------------------
   GroupBox
--------------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---------------------------------------------------------------------------
   Labels
--------------------------------------------------------------------------- */

QLabel {
    color: #1E293B;
}

/* ---------------------------------------------------------------------------
   Push Buttons
--------------------------------------------------------------------------- */

QPushButton {

    background-color: #2563EB;

    color: white;

    border: none;

    border-radius: 6px;

    padding: 8px 16px;

}

QPushButton:hover {

    background-color: #3B82F6;

}

QPushButton:pressed {

    background-color: #1D4ED8;

}

QPushButton:disabled {

    background-color: #CBD5E1;

    color: #64748B;

}

/* ---------------------------------------------------------------------------
   Line Edit
--------------------------------------------------------------------------- */

QLineEdit {

    background-color: white;

    border: 1px solid #CBD5E1;

    border-radius: 5px;

    padding: 6px;

}

QLineEdit:focus {

    border: 1px solid #2563EB;

}

/* ---------------------------------------------------------------------------
   ComboBox
--------------------------------------------------------------------------- */

QComboBox {

    background-color: white;

    border: 1px solid #CBD5E1;

    border-radius: 5px;

    padding: 5px;

}

QComboBox QAbstractItemView {

    background-color: white;

    selection-background-color: #2563EB;

}

/* ---------------------------------------------------------------------------
   Tree Widget
--------------------------------------------------------------------------- */

QTreeWidget {

    background-color: white;

    alternate-background-color: #F1F5F9;

    border: 1px solid #CBD5E1;

}

QTreeWidget::item:selected {

    background-color: #DBEAFE;

    color: #1E293B;

}

/* ---------------------------------------------------------------------------
   Table
--------------------------------------------------------------------------- */

QTableWidget {

    background-color: white;

    border: 1px solid #CBD5E1;

    gridline-color: #E2E8F0;

}

QHeaderView::section {

    background-color: #E2E8F0;

    color: #1E293B;

    border: none;

    padding: 6px;

}

/* ---------------------------------------------------------------------------
   Tabs
--------------------------------------------------------------------------- */

QTabWidget::pane {

    border: 1px solid #CBD5E1;

}

QTabBar::tab {

    background: #E2E8F0;

    color: #1E293B;

    padding: 8px 16px;

}

QTabBar::tab:selected {

    background: #2563EB;

    color: white;

}

/* ---------------------------------------------------------------------------
   Progress Bar
--------------------------------------------------------------------------- */

QProgressBar {

    border: 1px solid #CBD5E1;

    border-radius: 6px;

    text-align: center;

}

QProgressBar::chunk {

    background-color: #22C55E;

}

/* ---------------------------------------------------------------------------
   Scroll Bar
--------------------------------------------------------------------------- */

QScrollBar:vertical {

    background: #F1F5F9;

    width: 12px;

}

QScrollBar::handle:vertical {

    background: #CBD5E1;

    border-radius: 6px;

}

QScrollBar::handle:vertical:hover {

    background: #94A3B8;

}

/* ---------------------------------------------------------------------------
   Status Bar
--------------------------------------------------------------------------- */

QStatusBar {

    background-color: #F1F5F9;

    color: #1E293B;

}

/* ---------------------------------------------------------------------------
   Menu
--------------------------------------------------------------------------- */

QMenuBar {

    background-color: #F8FAFC;

}

QMenuBar::item:selected {

    background-color: #DBEAFE;

}

QMenu {

    background-color: white;

}

QMenu::item:selected {

    background-color: #DBEAFE;

}