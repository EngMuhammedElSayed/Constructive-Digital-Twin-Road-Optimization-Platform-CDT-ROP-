/* ============================================================================
   CDT-ROP Dark Theme
   Constructive Digital Twin Road Optimization Platform
   ============================================================================ */

/* ---------------------------------------------------------------------------
   Global
--------------------------------------------------------------------------- */

QWidget {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ---------------------------------------------------------------------------
   Main Window
--------------------------------------------------------------------------- */

QMainWindow {
    background-color: #0F172A;
}

/* ---------------------------------------------------------------------------
   GroupBox
--------------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---------------------------------------------------------------------------
   Labels
--------------------------------------------------------------------------- */

QLabel {
    color: #E2E8F0;
}

/* ---------------------------------------------------------------------------
   Push Buttons
--------------------------------------------------------------------------- */

QPushButton {

    background-color: #2563EB;

    color: white;

    border: none;

    border-radius: 6px;

    padding: 8px 16px;

}

QPushButton:hover {

    background-color: #3B82F6;

}

QPushButton:pressed {

    background-color: #1D4ED8;

}

QPushButton:disabled {

    background-color: #475569;

    color: #94A3B8;

}

/* ---------------------------------------------------------------------------
   LineEdit
--------------------------------------------------------------------------- */

QLineEdit {

    background-color: #1E293B;

    border: 1px solid #475569;

    border-radius: 5px;

    padding: 6px;

}

QLineEdit:focus {

    border: 1px solid #2563EB;

}

/* ---------------------------------------------------------------------------
   ComboBox
--------------------------------------------------------------------------- */

QComboBox {

    background-color: #1E293B;

    border: 1px solid #475569;

    border-radius: 5px;

    padding: 5px;

}

QComboBox QAbstractItemView {

    background-color: #1E293B;

    selection-background-color: #2563EB;

}

/* ---------------------------------------------------------------------------
   Tree Widget
--------------------------------------------------------------------------- */

QTreeWidget {

    background-color: #111827;

    alternate-background-color: #1E293B;

    border: 1px solid #334155;

}

QTreeWidget::item:selected {

    background-color: #2563EB;

}

/* ---------------------------------------------------------------------------
   Table
--------------------------------------------------------------------------- */

QTableWidget {

    background-color: #111827;

    gridline-color: #334155;

    border: 1px solid #334155;

}

QHeaderView::section {

    background-color: #1E293B;

    color: white;

    border: none;

    padding: 6px;

}

/* ---------------------------------------------------------------------------
   Tabs
--------------------------------------------------------------------------- */

QTabWidget::pane {

    border: 1px solid #334155;

}

QTabBar::tab {

    background: #1E293B;

    padding: 8px 16px;

}

QTabBar::tab:selected {

    background: #2563EB;

}

/* ---------------------------------------------------------------------------
   Progress Bar
--------------------------------------------------------------------------- */

QProgressBar {

    border: 1px solid #334155;

    border-radius: 6px;

    text-align: center;

}

QProgressBar::chunk {

    background-color: #22C55E;

}

/* ---------------------------------------------------------------------------
   ScrollBar
--------------------------------------------------------------------------- */

QScrollBar:vertical {

    background: #111827;

    width: 12px;

}

QScrollBar::handle:vertical {

    background: #475569;

    border-radius: 6px;

}

QScrollBar::handle:vertical:hover {

    background: #64748B;

}

/* ---------------------------------------------------------------------------
   Status Bar
--------------------------------------------------------------------------- */

QStatusBar {

    background-color: #111827;

    color: #CBD5E1;

}

/* ---------------------------------------------------------------------------
   Menu
--------------------------------------------------------------------------- */

QMenuBar {

    background-color: #111827;

}

QMenuBar::item:selected {

    background-color: #2563EB;

}

QMenu {

    background-color: #111827;

}

QMenu::item:selected {

    background-color: #2563EB;

}